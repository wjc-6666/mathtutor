# API 模式将问题与检索片段发给指定服务。offline 仅用于检索测试。
LLM_PROVIDER=offline
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=
VISION_MODEL=
# hash 是本地字符基线；hybrid 此时回退 BM25。真正语义可选免费 local。
EMBEDDING_PROVIDER=hash
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
OCR_ENGINE=windows
OCR_SCALE=2
# 可选：免费本地语义。先安装 requirements-semantic.txt 并下载模型。
LOCAL_EMBEDDING_PATH=data/models/multilingual-e5-small
RETRIEVAL_MIN_SCORE=0.2
